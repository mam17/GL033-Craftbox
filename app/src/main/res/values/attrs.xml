<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="RoundImageView">
        <attr name="cornerRadius" format="dimension" />
        <attr name="isOval" format="boolean" />
        <attr name="bgColor" format="color" />
        <attr name="enableScaleAnim" format="boolean" />
        <attr name="iconTint" format="color" />
        <attr name="strokeEnable" format="boolean" />
        <attr name="strokeColor" format="color" />
        <attr name="strokeWidth" format="dimension" />
    </declare-styleable>

    <declare-styleable name="BubbleView">

        <attr name="bubbleType">
            <enum name="round" value="0" />
            <enum name="roundRightTail" value="1" />
            <enum name="leftCut" value="2" />
            <enum name="oval" value="3" />
            <enum name="leftTail" value="4" />
            <enum name="bottomRightTail" value="5" />
        </attr>

        <attr name="bubbleRadius" format="dimension" />
        <attr name="bubbleTailSize" format="dimension" />
        <attr name="bubbleColor1" format="color" />
        <attr name="bubbleStrokeColor" format="color" />
        <attr name="bubbleStrokeWidth" format="dimension" />

    </declare-styleable>
    <declare-styleable name="MessageBubbleView">
        <attr name="cornerRadiusBBV" format="dimension" />
        <attr name="bubbleColor" format="color" />
        <attr name="caretWidth" />
        <attr name="caretHeight" />
        <attr name="caretPosition" />
        <attr name="wrapContentMaxWidthPercent" format="fraction" />
    </declare-styleable>
    <attr name="caretPosition" format="integer">
        <flag name="none" value="0x0" />
        <flag name="top" value="0x30" />
        <flag name="bottom" value="0x50" />
        <flag name="left" value="0x03" />
        <flag name="right" value="0x05" />
        <flag name="start" value="0x00800003" />
        <flag name="end" value="0x00800005" />
        <flag name="vertical" value="0x80" />

        <flag name="topLeft" value="0x33" />
        <flag name="topRight" value="0x35" />
        <flag name="topCenter" value="0xB0" />
        <flag name="bottomLeft" value="0x53" />
        <flag name="bottomRight" value="0x55" />
        <flag name="bottomCenter" value="0xD0" />

        <flag name="centerLeft" value="0x0b" />
        <flag name="centerRight" value="0x0d" />
        <flag name="centerStart" value="0x0080000b" />
        <flag name="centerEnd" value="0x0080000d" />

        <flag name="topStart" value="0x00800033" />
        <flag name="topEnd" value="0x00800035" />
        <flag name="bottomStart" value="0x00800053" />
        <flag name="bottomEnd" value="0x00800055" />
    </attr>
    <attr name="caretWidth" format="dimension|enum">
        <enum name="view_width" value="-1" />
    </attr>
    <attr name="caretHeight" format="dimension|enum">
        <enum name="view_height" value="-1" />
    </attr>

    <declare-styleable name="CustomBackgroundView">

        <!-- ══════════════════════════════════════════════
             CORNER RADIUS
             Dùng cbv_cornerRadius để bo đều 4 góc.
             Hoặc set từng góc riêng bằng code (cornerRadii).
        ══════════════════════════════════════════════ -->
        <attr name="cbv_cornerRadius" format="dimension" />

        <!-- ══════════════════════════════════════════════
             SOLID COLOR BACKGROUND
        ══════════════════════════════════════════════ -->
        <attr name="cbv_solidColor" format="color" />

        <!-- ══════════════════════════════════════════════
             GRADIENT BACKGROUND
             Dùng 2 màu (start + end) hoặc 3 màu (+ center).
             Khi set gradient, solidColor bị bỏ qua.
        ══════════════════════════════════════════════ -->
        <attr name="cbv_gradientStartColor"  format="color" />
        <attr name="cbv_gradientCenterColor" format="color" />
        <attr name="cbv_gradientEndColor"    format="color" />

        <!-- Hướng gradient:
             0 = LEFT_RIGHT (mặc định)
             1 = TOP_BOTTOM
             2 = TL_BR  (chéo trái-trên → phải-dưới)
             3 = TR_BL  (chéo phải-trên → trái-dưới)
        -->
        <attr name="cbv_gradientOrientation" format="enum">
            <enum name="leftToRight"    value="0" />
            <enum name="topToBottom"    value="1" />
            <enum name="tlToBr"         value="2" />
            <enum name="trToBl"         value="3" />
        </attr>

        <!-- ══════════════════════════════════════════════
             BITMAP BACKGROUND
             Nhận drawable từ XML; khi set, gradient/solid bị bỏ qua.
        ══════════════════════════════════════════════ -->
        <attr name="cbv_backgroundBitmap" format="reference" />

        <!-- Scale type cho bitmap:
             0 = CROP  – lấp đầy view, crop phần thừa (mặc định)
             1 = FIT   – vừa khít, giữ tỉ lệ, có thể có khoảng trống
        -->
<!--        <attr name="cbv_bitmapScaleType" format="enum">-->
<!--            <enum name="crop" value="0" />-->
<!--            <enum name="fit"  value="1" />-->
<!--        </attr>-->
        <attr name="cbv_bitmapScaleType" format="enum">
            <enum name="center"        value="0" />
            <enum name="centerCrop"    value="1" />
            <enum name="centerInside"  value="2" />
            <enum name="fitCenter"     value="3" />
            <enum name="fitStart"      value="4" />
            <enum name="fitEnd"        value="5" />
            <enum name="fitXY"         value="6" />
        </attr>

        <!-- ══════════════════════════════════════════════
             BLUR  (mặc định disabled)
        ══════════════════════════════════════════════ -->
        <!-- Bật / tắt blur -->
        <attr name="cbv_blurEnabled" format="boolean" />
        <!-- Độ blur: 1.0 – 25.0 -->
        <attr name="cbv_blurRadius"  format="float"   />

        <!-- ══════════════════════════════════════════════
             STROKE  (mặc định disabled)
        ══════════════════════════════════════════════ -->
        <!-- Bật / tắt viền -->
        <attr name="cbv_strokeEnabled" format="boolean"   />
        <!-- Màu viền -->
        <attr name="cbv_strokeColor"   format="color"     />
        <!-- Độ dày viền (px / dp) -->
        <attr name="cbv_strokeWidth"   format="dimension" />

    </declare-styleable>
</resources>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/size6">

    <com.grl.sms_wa.views.RoundImageView
        android:id="@+id/ivBGTheme"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:bgColor="@color/grey"
        app:cornerRadius="@dimen/size12"
        app:enableScaleAnim="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="9:16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/llLibrary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@+id/ivBGTheme"
        app:layout_constraintEnd_toEndOf="@+id/ivBGTheme"
        app:layout_constraintStart_toStartOf="@+id/ivBGTheme"
        app:layout_constraintTop_toTopOf="@+id/ivBGTheme">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_defaut_image" />

        <TextView
            style="@style/TextView_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size8"
            android:text="@string/txt_library"
            android:textColor="@color/white" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

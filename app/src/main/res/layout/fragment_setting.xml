<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/size16"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/TextView_7"
            android:text="@string/txt_settings"
            android:textColor="@color/col_main"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/vLine"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size1"
        android:background="@color/col_14000000"
        app:layout_constraintTop_toBottomOf="@+id/clTopBar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginVertical="@dimen/size12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vLine">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/TextView_7"
                android:layout_marginStart="@dimen/size16"
                android:text="@string/txt_general"
                android:textColor="@color/col_main"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/size16"
                android:background="@drawable/bg_mess"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/llNotification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/size10"
                    android:paddingVertical="@dimen/size12"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivNotifications"
                        android:layout_width="@dimen/size24"
                        android:layout_height="@dimen/size24"
                        android:src="@drawable/sl_notification"
                        app:tint="@color/col_main" />

                    <TextView
                        style="@style/TextView_6"
                        android:layout_marginStart="@dimen/size16"
                        android:text="@string/txt_notification"
                        android:textColor="@color/col_main" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/size10"
                    android:paddingVertical="@dimen/size12">

                    <ImageView
                        android:layout_width="@dimen/size24"
                        android:layout_height="@dimen/size24"
                        android:src="@drawable/ic_setting_language"
                        app:tint="@color/col_main" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/size16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextView_6"
                            android:text="@string/txt_language"
                            android:textColor="@color/col_main" />

                        <TextView
                            android:id="@+id/tvLangSelected"
                            style="@style/TextView_4"
                            android:text="@string/txt_english"
                            android:textColor="@color/col_main"
                            android:textSize="@dimen/size12" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llPolicy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/size10"
                    android:paddingVertical="@dimen/size12">

                    <ImageView
                        android:layout_width="@dimen/size24"
                        android:layout_height="@dimen/size24"
                        android:src="@drawable/ic_policy"
                        app:tint="@color/col_main" />

                    <TextView
                        style="@style/TextView_6"
                        android:layout_marginStart="@dimen/size16"
                        android:text="@string/txt_private_policy"
                        android:textColor="@color/col_main" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llRateUs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/size10"
                    android:paddingVertical="@dimen/size12">

                    <ImageView
                        android:layout_width="@dimen/size24"
                        android:layout_height="@dimen/size24"
                        android:src="@drawable/ic_rate_us"
                        app:tint="@color/col_main" />

                    <TextView
                        style="@style/TextView_6"
                        android:layout_marginStart="@dimen/size16"
                        android:text="@string/txt_rate_us"
                        android:textColor="@color/col_main" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/size16"
                android:background="@drawable/bg_mess"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/llDelayedSending"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/size10"
                    android:paddingVertical="@dimen/size12">

                    <ImageView
                        android:layout_width="@dimen/size24"
                        android:layout_height="@dimen/size24"
                        android:src="@drawable/ic_setting_delay"
                        app:tint="@color/col_main" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/size16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextView_6"
                            android:text="@string/txt_delayed_sending"
                            android:textColor="@color/col_main" />

                        <TextView
                            style="@style/TextView_4"
                            android:text="@string/txt_no_delay"
                            android:textColor="@color/col_main" />
                    </LinearLayout>
                </LinearLayout>
                <!-- Swipe actions -->
                <LinearLayout
                    android:id="@+id/llSwipeActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/size10"
                    android:paddingVertical="@dimen/size12">

                    <ImageView
                        android:layout_width="@dimen/size24"
                        android:layout_height="@dimen/size24"
                        android:src="@drawable/ic_setting_swipe"
                        app:tint="@color/col_main" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/size16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextView_6"
                            android:text="@string/txt_swipe_actions"
                            android:textColor="@color/col_main" />

                        <TextView
                            style="@style/TextView_4"
                            android:text="@string/txt_swipe_actions_desc"
                            android:textColor="@color/col_main" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Delivery confirmations -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/size10"
                    android:paddingVertical="@dimen/size12">

                    <ImageView
                        android:layout_width="@dimen/size24"
                        android:layout_height="@dimen/size24"
                        android:src="@drawable/ic_setting_send"
                        app:tint="@color/col_main" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/size16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextView_6"
                            android:text="@string/txt_delivery_confirmations"
                            android:textColor="@color/col_main" />

                        <TextView
                            style="@style/TextView_4"
                            android:text="@string/txt_delivery_confirmations_desc"
                            android:textColor="@color/col_main" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/sl_switch" />
                </LinearLayout>

                <!-- Signature -->
                <LinearLayout
                    android:id="@+id/llSignature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/size10"
                    android:paddingVertical="@dimen/size12">

                    <ImageView
                        android:layout_width="@dimen/size24"
                        android:layout_height="@dimen/size24"
                        android:src="@drawable/ic_setting_signature"
                        app:tint="@color/col_main" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/size16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextView_6"
                            android:text="@string/txt_signature"
                            android:textColor="@color/col_main" />

                        <TextView
                            style="@style/TextView_4"
                            android:text="@string/txt_signature_desc"
                            android:textColor="@color/col_main" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Strip accents -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/size10"
                    android:paddingVertical="@dimen/size12">

                    <ImageView
                        android:layout_width="@dimen/size24"
                        android:layout_height="@dimen/size24"
                        android:src="@drawable/ic_setting_person"
                        app:tint="@color/col_main" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/size16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextView_6"
                            android:text="@string/txt_strip_accents"
                            android:textColor="@color/col_main" />

                        <TextView
                            style="@style/TextView_4"
                            android:text="@string/txt_strip_accents_desc"
                            android:textColor="@color/col_main" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/sl_switch" />
                </LinearLayout>

                <!-- Mobile numbers only -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/size10"
                    android:paddingVertical="@dimen/size12">

                    <ImageView
                        android:layout_width="@dimen/size24"
                        android:layout_height="@dimen/size24"
                        android:src="@drawable/ic_setting_123"
                        app:tint="@color/col_main" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/size16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextView_6"
                            android:text="@string/txt_mobile_numbers_only"
                            android:textColor="@color/col_main" />

                        <TextView
                            style="@style/TextView_4"
                            android:text="@string/txt_mobile_numbers_only_desc"
                            android:textColor="@color/col_main" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/sl_switch" />
                </LinearLayout>

                <!-- Send long messages as MMS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/size10"
                    android:paddingVertical="@dimen/size12">

                    <ImageView
                        android:layout_width="@dimen/size24"
                        android:layout_height="@dimen/size24"
                        android:src="@drawable/ic_setting_chat"
                        app:tint="@color/col_main" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/size16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextView_6"
                            android:text="@string/txt_send_long_messages_as_mms"
                            android:textColor="@color/col_main" />

                        <TextView
                            style="@style/TextView_4"
                            android:text="@string/txt_send_long_messages_as_mms_desc"
                            android:textColor="@color/col_main" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/sl_switch" />
                </LinearLayout>

                <!-- Auto-compress MMS -->
                <LinearLayout
                    android:id="@+id/llAutoCompress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/size10"
                    android:paddingVertical="@dimen/size12">

                    <ImageView
                        android:layout_width="@dimen/size24"
                        android:layout_height="@dimen/size24"
                        android:src="@drawable/ic_setting_zoom"
                        app:tint="@color/col_main" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/size16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextView_6"
                            android:text="@string/txt_auto_compress_mms"
                            android:textColor="@color/col_main" />

                        <TextView
                            style="@style/TextView_4"
                            android:text="@string/txt_300kb"
                            android:textColor="@color/col_main" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Sync messages -->
                <LinearLayout
                    android:id="@+id/llSync"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size16"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/size10"
                    android:paddingVertical="@dimen/size12">

                    <ImageView
                        android:layout_width="@dimen/size24"
                        android:layout_height="@dimen/size24"
                        android:src="@drawable/ic_setting_mail"
                        app:tint="@color/col_main" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/size16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextView_6"
                            android:text="@string/txt_sync_messages"
                            android:textColor="@color/col_main" />

                        <TextView
                            style="@style/TextView_4"
                            android:text="@string/txt_sync_messages_desc"
                            android:textColor="@color/col_main" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/size6">

    <com.grl.sms_wa.views.RoundImageView
        android:id="@+id/ivFeature"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/img_feature1"
        app:cornerRadius="@dimen/size10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/size10"
        android:clickable="false"
        android:focusable="false"
        android:src="@drawable/sl_check_feature"
        app:layout_constraintEnd_toEndOf="@+id/ivFeature"
        app:layout_constraintTop_toTopOf="@+id/ivFeature" />

    <TextView
        android:id="@+id/tvItemFeature"
        style="@style/TextView_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/size20"
        android:layout_marginBottom="@dimen/size16"
        android:background="@drawable/bg_btn_ok"
        android:clickable="false"
        android:ellipsize="end"
        android:focusable="false"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/size6"
        android:paddingVertical="@dimen/size6"
        android:text="Background"
        android:textColor="@color/white"
        android:textSize="@dimen/size12"
        app:layout_constraintBottom_toBottomOf="@+id/ivFeature" />
</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ctItemMessage"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/size16"
    android:paddingVertical="@dimen/size10">

    <!-- Avatar -->
    <FrameLayout
        android:id="@+id/flAvatar"
        android:layout_width="@dimen/size50"
        android:layout_height="@dimen/size50"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.example.myapplication.views.RoundImageView
            android:id="@+id/ivAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/size6"
            android:src="@drawable/ic_person"
            app:bgColor="@color/col_main"
            app:isOval="true" />

        <TextView
            android:id="@+id/tvFirstName"
            style="@style/TextView_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:includeFontPadding="false"
            android:text="@string/txt_empty" />
    </FrameLayout>


    <!-- Name + Date -->
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size12"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/flAvatar"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvAddress"
            style="@style/TextView_7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="John Doe"
            android:textColor="@color/col_main"
            android:textSize="@dimen/size14" />

        <TextView
            android:id="@+id/tvDate"
            style="@style/TextView_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Feb 5th"
            android:textSize="@dimen/size12" />
    </LinearLayout>


    <!-- Message body -->
    <TextView
        android:id="@+id/tvBody"
        style="@style/TextView_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size12"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="[TB] Grab these special data packages hahahahahahahahahahah for Tet!..."
        android:textColor="@color/gray"
        android:textSize="@dimen/size12"
        app:layout_constraintEnd_toStartOf="@id/ivUnread"
        app:layout_constraintStart_toEndOf="@id/flAvatar"
        app:layout_constraintTop_toBottomOf="@id/llHeader" />


    <!-- Unread dot -->
    <View
        android:id="@+id/ivUnread"
        android:layout_width="@dimen/size10"
        android:layout_height="@dimen/size10"
        android:layout_marginTop="6dp"
        android:src="@drawable/bg_circle_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llHeader" />

</androidx.constraintlayout.widget.ConstraintLayout>
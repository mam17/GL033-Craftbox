<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/size6"
    android:gravity="center_vertical">

    <com.grl.sms_wa.views.RoundImageView
        android:id="@+id/ivCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/sl_check_feature" />

    <TextView
        android:id="@+id/tvFont"
        style="@style/TextView_5"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size8"
        android:text="@string/txt_font"
        android:textColor="@color/col_main"
        android:textSize="14sp" />

</LinearLayout>
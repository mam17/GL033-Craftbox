<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.grl.sms_wa.views.RoundImageView
        android:id="@+id/ivChooseTheme"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/size20"
        android:scaleType="centerCrop"
        app:cornerRadius="@dimen/size20"
        app:enableScaleAnim="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="9:20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.grl.sms_wa.views.RoundImageView
        android:id="@+id/ivDownload"
        android:layout_width="@dimen/size40"
        android:layout_height="@dimen/size40"
        android:layout_marginBottom="@dimen/size30"
        android:padding="@dimen/size4"
        android:src="@drawable/ic_download"
        app:enableScaleAnim="false"
        app:isOval="true"
        app:layout_constraintBottom_toBottomOf="@+id/ivChooseTheme"
        app:layout_constraintEnd_toEndOf="@+id/ivChooseTheme"
        app:layout_constraintStart_toStartOf="@+id/ivChooseTheme"
        app:strokeColor="@color/col_main"
        app:strokeEnable="true"
        app:strokeWidth="@dimen/size1" />

    <ProgressBar
        android:id="@+id/prLoading"
        android:layout_width="@dimen/size40"
        android:layout_height="@dimen/size40"
        android:layout_marginBottom="@dimen/size30"
        android:indeterminateTint="@color/col_main"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/ivChooseTheme"
        app:layout_constraintEnd_toEndOf="@+id/ivChooseTheme"
        app:layout_constraintStart_toStartOf="@+id/ivChooseTheme" />
</androidx.constraintlayout.widget.ConstraintLayout>
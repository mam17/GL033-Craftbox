<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/toolbarDTSticker"
        layout="@layout/layout_toolbar" />

    <ImageView
        android:id="@+id/ivStickerLogo"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size200"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintTop_toBottomOf="@+id/toolbarDTSticker" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnDownload"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size44"
        android:layout_marginHorizontal="@dimen/size16"
        android:layout_marginTop="@dimen/size16"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@color/col_main"
        app:cardCornerRadius="@dimen/size35"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@+id/ivStickerLogo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDownload"
                style="@style/TextView_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/txt_download" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivDone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size10"
                android:contentDescription="@null"
                android:src="@drawable/ic_check"
                app:tint="@color/white" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvStickerStore"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/size12"
        android:paddingHorizontal="@dimen/size8"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnDownload"
        app:spanCount="3"
        tools:listitem="@layout/item_sticker_detail" />


</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/size16"
    android:background="?android:selectableItemBackground"
    android:paddingVertical="@dimen/size8">

    <com.example.myapplication.views.RoundImageView
        android:id="@+id/ivAvatar"
        android:layout_width="@dimen/size40"
        android:layout_height="@dimen/size40"
        android:src="@mipmap/ic_launcher"
        app:isOval="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size16"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivAvatar"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:maxLines="1"
            android:ellipsize="end"
            android:id="@+id/tvNameDirectory"
            style="@style/TextView_7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name" />

        <TextView
            android:maxLines="1"
            android:ellipsize="end"
            android:id="@+id/tvNumberPhone"
            style="@style/TextView_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="098765432"
            android:textSize="@dimen/size12" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
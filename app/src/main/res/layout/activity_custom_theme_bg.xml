<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.components.custom.activity.CustomBGThemeActivity">

    <com.grl.sms_wa.views.CustomBackgroundView
        android:id="@+id/backgroundTheme"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cbv_solidColor="@color/white" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="@dimen/size40"
            android:layout_height="@dimen/size40"
            android:layout_marginStart="@dimen/size8"
            android:padding="@dimen/size8"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/col_main" />

        <TextView
            style="@style/TextView_7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size16"
            android:text="Background"
            android:textColor="@color/col_main"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivBack"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivReset"
            android:layout_width="@dimen/size40"
            android:layout_height="@dimen/size40"
            android:layout_marginEnd="@dimen/size8"
            android:padding="@dimen/size8"
            android:src="@drawable/ic_history_2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/col_main" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvChatPreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/llBottomPanel"
        app:layout_constraintTop_toBottomOf="@id/clHeader"
        tools:listitem="@layout/item_chat_left" />


    <LinearLayout
        android:id="@+id/llBottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_border_sheet_custom"
        android:orientation="vertical"
        android:padding="@dimen/size16"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_r8"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/size12">
            <!-- Blur Control -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextView_5"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="Blur"
                    android:textColor="@color/col_main" />

                <ImageView
                    android:layout_width="@dimen/size24"
                    android:layout_height="@dimen/size24"
                    android:src="@drawable/ic_blur" />

                <SeekBar
                    android:id="@+id/sbBlur"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="25"
                    android:progress="0"
                    android:progressTint="@color/black"
                    android:thumbTint="@color/black" />
            </LinearLayout>

            <!-- Overlay Control -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextView_5"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="Overlay"
                    android:textColor="@color/col_main" />

                <ImageView
                    android:layout_width="@dimen/size24"
                    android:layout_height="@dimen/size24"
                    android:src="@drawable/ic_overlay" />

                <SeekBar
                    android:id="@+id/sbOverlay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/black"
                    android:thumbTint="@color/black" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/size16" />

        <!-- Tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnPicture"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_selected"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="@dimen/size32"
                    android:layout_height="@dimen/size32"
                    android:src="@drawable/img_picture" />

                <TextView
                    style="@style/TextView_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Picture"
                    android:textColor="@color/col_main" />
            </LinearLayout>

            <View
                android:layout_width="@dimen/size12"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/btnColor"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:background="@drawable/bg_white_r8"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="@dimen/size32"
                    android:layout_height="@dimen/size32"
                    android:src="@drawable/img_filter_color" />

                <TextView
                    style="@style/TextView_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Color"
                    android:textColor="@color/col_main" />
            </LinearLayout>

            <View
                android:layout_width="@dimen/size12"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/btnGradient"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:background="@drawable/bg_white_r8"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="@dimen/size32"
                    android:layout_height="@dimen/size32"
                    android:src="@drawable/img_gradient_color" />

                <TextView
                    style="@style/TextView_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gradient"
                    android:textColor="@color/col_main" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/size24" />

        <!-- Apply Button -->
        <TextView
            android:id="@+id/btnApply"
            style="@style/TextView_7"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_btn_r10_main"
            android:gravity="center"
            android:text="Apply"
            android:textColor="@color/white" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="@dimen/size32"
        android:layout_height="@dimen/size32"
        android:layout_margin="@dimen/size16"
        android:contentDescription="@null"
        android:padding="@dimen/size4"
        android:src="@drawable/ic_cancel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/col_main" />

    <TextView
        android:id="@+id/tvTitle"
        style="@style/TextView_7"
        android:layout_marginTop="@dimen/size60"
        android:text="@string/txt_set_password"
        android:textColor="@color/col_main"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvDesc"
        style="@style/TextView_4"
        android:layout_marginTop="@dimen/size16"
        android:gravity="center"
        android:paddingHorizontal="@dimen/size40"
        android:text="@string/txt_please_enter_pin"
        android:textColor="@color/col_main"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

    <LinearLayout
        android:id="@+id/llPinContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size32"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDesc">

        <EditText
            android:id="@+id/edtPin1"
            style="@style/TextView_7"
            android:layout_width="@dimen/size50"
            android:layout_height="@dimen/size60"
            android:layout_marginHorizontal="@dimen/size4"
            android:background="@drawable/bg_pin_code"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1" />

        <EditText
            android:id="@+id/edtPin2"
            style="@style/TextView_7"
            android:layout_width="@dimen/size50"
            android:layout_height="@dimen/size60"
            android:layout_marginHorizontal="@dimen/size4"
            android:background="@drawable/bg_pin_code"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1" />

        <EditText
            android:id="@+id/edtPin3"
            style="@style/TextView_7"
            android:layout_width="@dimen/size50"
            android:layout_height="@dimen/size60"
            android:layout_marginHorizontal="@dimen/size4"
            android:background="@drawable/bg_pin_code"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1" />

        <EditText
            android:id="@+id/edtPin4"
            style="@style/TextView_7"
            android:layout_width="@dimen/size50"
            android:layout_height="@dimen/size60"
            android:layout_marginHorizontal="@dimen/size4"
            android:background="@drawable/bg_pin_code"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
